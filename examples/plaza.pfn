# polyfork graph v2 — plaza
graph plaza
in colorway enum gallery-white options=gallery-white|atrium-mint|promenade-violet|transit-blossom label=Colorway
in deck color "" label=Deck
in seam color "" label=Seam
in strip color "" label="Light strip"
in edge color "" label=Underside
in ring color "" label="Socket rim"
in cap color "" label="Socket cap"
in seams enum twin options=single|twin|quad label=Seams
in strips enum all options=none|one|all label="Light strips"
in socket bool true label="Service socket"
n n0 preset choice=$colorway overrides={deck:$deck,seam:$seam,strip:$strip,edge:$edge,ring:$ring,cap:$cap} presets={gallery-white:{deck:#f4f7fa,seam:#b9c5d2,strip:#5fb3e0,edge:#3f4a58,ring:#6e7f92,cap:#a9b6c4},atrium-mint:{deck:#ffffff,seam:#c8d2dc,strip:#7fe7da,edge:#2a323d,ring:#7b8a9c,cap:#a9b6c4},promenade-violet:{deck:#e6ecf2,seam:#a9b6c4,strip:#b7a6f5,edge:#2a323d,ring:#5d6b7c,cap:#8e9eae},transit-blossom:{deck:#f4f7fa,seam:#b9c5d2,strip:#ff9ec7,edge:#1b212a,ring:#5d6b7c,cap:#9aa8b8}} fallback=gallery-white
n n1 plazaTile seams=$seams strips=$strips socket=$socket
n n2 mesh geom=@n1 zones={deck:@n0.deck,seam:@n0.seam,strip:@n0.strip,edge:@n0.edge,ring:@n0.ring,cap:@n0.cap}
out mesh=@n2
end
