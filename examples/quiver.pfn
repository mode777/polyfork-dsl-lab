# polyfork graph v2 — quiver
graph quiver
in colorway enum saddle-tan options=saddle-tan|oxblood|ranger-green|frost-steel label=Colorway
in length float 1 min=0.8 max=1.25 step=0.05 label="Tube length"
in taper float 0.5 min=0 max=1 step=0.05 label=Taper
in strap bool true label="Shoulder strap"
n n0 preset choice=$colorway presets={saddle-tan:{leather:#9d846c,rim:#6e423a,stitch:#54352f,shaft:#715a4e,fletch:#d9dbe0,buckle:#c6ab55,bark:#8c6857,cord:#e1e1e5,alloy:#95a0b5,fittings:#45495d,glow:#5deaff},oxblood:{leather:#a0454b,rim:#54352f,stitch:#b2a299,shaft:#8c6857,fletch:#e1e1e5,buckle:#95a0b5,bark:#715a4e,cord:#d9dbe0,alloy:#7f8da3,fittings:#4f6284,glow:#63cadc},ranger-green:{leather:#27372e,rim:#54352f,stitch:#9d846c,shaft:#8c6857,fletch:#e1e1e5,buckle:#c6ab55,bark:#6e423a,cord:#b2a299,alloy:#6e7b97,fittings:#45495d,glow:#4eb764},frost-steel:{leather:#7f8da3,rim:#4f6284,stitch:#d9dbe0,shaft:#9d846c,fletch:#e1e1e5,buckle:#c6ab55,bark:#b2a299,cord:#af8984,alloy:#95a0b5,fittings:#45495d,glow:#5deaff}} fallback=saddle-tan
n n1 quiver length=$length taper=$taper strap=$strap
n n2 mesh geom=@n1 zones={leather:@n0.leather,rim:@n0.rim,stitch:@n0.stitch,shaft:@n0.shaft,fletch:@n0.fletch,buckle:@n0.buckle,bark:@n0.bark,cord:@n0.cord,alloy:@n0.alloy,fittings:@n0.fittings,glow:@n0.glow}
out mesh=@n2
end
