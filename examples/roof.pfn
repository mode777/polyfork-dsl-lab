# polyfork graph v2 — roof
graph roof
in colorway enum slate-kawara options=slate-kawara|charcoal-machiya|pale-alley|shrine-vermilion label=Colorway
in roofPitch float 35 min=25 max=45 step=1 label="Roof pitch"
in ribs int 8 min=5 max=9 step=1 label="Tile rolls"
in courses int 4 min=3 max=5 step=1 label="Tile courses"
n n0 preset choice=$colorway presets={slate-kawara:{tile:#4E5459,ridge:#3C4145,trim:#7E4B33,plaster:#F0EFEC},charcoal-machiya:{tile:#3C4145,ridge:#2E3134,trim:#42352A,plaster:#ECE8DE},pale-alley:{tile:#8A9197,ridge:#6B7278,trim:#8C7355,plaster:#F7F5EF},shrine-vermilion:{tile:#4E5459,ridge:#3C4145,trim:#B5462F,plaster:#F7F5EF}} fallback=slate-kawara
n n1 roofGable pitch=$roofPitch ribs=$ribs courses=$courses
n n2 mesh geom=@n1 zones={tile:@n0.tile,ridge:@n0.ridge,trim:@n0.trim,plaster:@n0.plaster}
out mesh=@n2
end
