# polyfork graph v2 — cookie
graph cookie
in thickness float 0.026 min=0.014 max=0.034
in chips int 9 min=3 max=14
in chipColor color #4a2a18
n n0 revolve profile=[[0.001,0],[0.045000000000000005,0],[0.05,0.00208],[0.05,0.0143],[0.047,0.0208],[0.001,0.026]] seg=18 zone=[edge,edge,dough,dough,dough]
n n1 scatter count=$chips minDist=~`s => s.chips > 9 ? 0.017 : 0.019` seed=42 tries=800 sample=`(()=>{const a=hash(i,1)*TAU,f=0.15+hash(i,2)*0.7;return [cos(a)*f*0.05,sin(a)*f*0.05];})()` height=`s.thickness*(0.8+0.2*(1-hypot(x,z)/0.05/0.94))+0.0045` size=`() => 1`
n n2 chamferBox w=0.016 h=0.009 d=0.014 c=0.003 seg=1 zone=chip
n n3 instance points=@n1 proto=@n2
n n4 join geoms=[@n0,@n3]
n n5 mesh geom=@n4 zones={dough:#e0aa5e,edge:#c4843c,chip:$chipColor}
out mesh=@n5
end
