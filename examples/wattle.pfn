# polyfork graph v2 — wattle
graph wattle
in colorway enum seasoned options=seasoned|peeled|weathered|fresh-hazel label=Colorway
in height float 1.2 min=0.9 max=1.4 step=0.05 label=Height
in unevenness float 0.5 min=0 max=1 step=0.05 label=Unevenness
n n0 preset choice=$colorway presets={seasoned:{stake:#7f5430,withy:#a88661,rope:#b49970},peeled:{stake:#6b4326,withy:#c8b89e,rope:#b49970},weathered:{stake:#625249,withy:#a9977e,rope:#b8a88e},fresh-hazel:{stake:#4e301c,withy:#9b673d,rope:#c8b89e}} fallback=seasoned
n n1 wattleFence height=$height unevenness=$unevenness
n n2 mesh geom=@n1 zones={stake:@n0.stake,withy:@n0.withy,rope:@n0.rope}
out mesh=@n2
end
