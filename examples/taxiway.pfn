# polyfork graph v2 — taxiway
graph taxiway
in colorway enum mustard options=mustard|graphite|aluminium label=Colorway
in panels int 2 min=1 max=4 step=1 label=Panels
n n0 preset choice=$colorway presets={mustard:{casing:#a3b173,steel:#7b787c,concrete:#948f8f,field:#282f3f},graphite:{casing:#575451,steel:#948f8f,concrete:#dddbdc,field:#282f3f},aluminium:{casing:#e5e3e3,steel:#7b787c,concrete:#948f8f,field:#3a4d6b}} fallback=mustard
n n1 taxiwaySign panels=$panels footing=true
n n2 mesh geom=@n1 zones={casing:@n0.casing,casingTop:#a8b47b,casingBezel:#a6b378,casingLow:#9aa66f,steel:@n0.steel,steelLow:#767376,concrete:@n0.concrete,field:@n0.field,signYellow:#cbc852,signRed:#b94c34,signWhite:#f5f3f4}
out mesh=@n2
end
