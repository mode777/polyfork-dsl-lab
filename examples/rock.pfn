# polyfork graph v2 — rock
graph rock
n n0 sphere r=0.32 seg=12 rings=8
n n1 deform geom=@n0 expr=`(x, y, z) => {\n    const k = 1 + 0.18 * Math.sin(3 * x + 1.7) * Math.cos(2.4 * z - 0.4) + 0.08 * Math.sin(7 * y);\n    return [x * k, y * k * 0.72, z * k];\n  }`
n n2 clip geom=@n1 nx=0.2 ny=1 nz=0.1 d=0.16 cap=true zone=rock
n n3 clip geom=@n2 nx=-1 ny=0.2 nz=0.3 d=0.24 cap=true zone=rock
n n4 center geom=@n3 y=false
n n5 mesh geom=@n4 zones={rock:#8a8578}
out mesh=@n5
end
