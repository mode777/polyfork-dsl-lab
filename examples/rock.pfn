# polyfork graph v2 — rock
graph rock
n n0 sphere r=0.31 seg=7 rings=5
n n1 deform geom=@n0 expr=`(x, y, z) => {\n    const k = 1 + 0.28 * Math.sin(3 * x + 1.7) * Math.cos(2.4 * z - 0.4) + 0.14 * Math.sin(7 * y + 0.5);\n    return [x * k, y * k * 0.72, z * k];\n  }`
n n2 clip geom=@n1 nx=0.2 ny=1 nz=0.2 d=0.11 cap=true zone=rock
n n3 clip geom=@n2 nx=-1 ny=0.2 nz=0.25 d=0.18 cap=true zone=rock
n n4 clip geom=@n3 nx=0.35 ny=0.25 nz=1 d=0.17 cap=true zone=rock
n n5 center geom=@n4 y=false
n n6 mesh geom=@n5 zones={rock:#8a8578}
out mesh=@n6
end
