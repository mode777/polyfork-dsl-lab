# polyfork graph v2 — rug
graph rug
in colorway enum linen-sage options=linen-sage|oat-terracotta|walnut-ochre|slate-teal label=Colorway
in field color "" label=Field
in border color "" label=Border
in motif color "" label=Motif
in backing color "" label=Backing
in pattern enum geometric options=plain|bordered|geometric label=Pattern
in size enum small options=small|large label=Size
in pile float 0.25 min=0 max=1 step=0.05 label=Pile
in lived_in float 0.35 min=0 max=1 step=0.05 label="Lived in"
n n0 script size=$size pile=$pile lived_in=$lived_in lang=js src=<<<

const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
const SIZES = { small: { W: 2.00, D: 1.50, NX: 10, NZ: 8 }, large: { W: 3.00, D: 2.00, NX: 15, NZ: 10 } };
const RC = 0.30, CH = 0.07, WOB = 0.024, KRUCK = 3;
const { W, D, NX, NZ } = SIZES[inputs.size] || SIZES.small;
const pile = clamp(inputs.pile, 0, 1), lived = clamp(inputs.lived_in, 0, 1);
const px = W / NX, pz = D / NZ;
const TH = 0.014 + pile * 0.024;
const AMP = pile * 0.011;
let seed = 7681;
const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const wob = [];
for (let i = 0; i <= NX; i++) { wob.push([]); for (let j = 0; j <= NZ; j++) wob[i].push(rnd()); }

const top = [], bot = [];
for (let i = 0; i <= NX; i++) {
  top.push([]); bot.push([]);
  for (let j = 0; j <= NZ; j++) {
    let x = -W / 2 + i * px, z = -D / 2 + j * pz;
    const s = (NX - i) + (NZ - j);
    const ax = clamp((Math.abs(x) - (W / 2 - RC)) / RC, 0, 1);
    const az = clamp((Math.abs(z) - (D / 2 - RC)) / RC, 0, 1);
    const cut = CH * Math.max(0, ax + az - 1);
    x -= Math.sign(x) * cut;
    z -= Math.sign(z) * cut;
    if (s !== KRUCK) {
      const w = wob[i][j] * WOB;
      if (i === 0) x += w; else if (i === NX) x -= w;
      if (j === 0) z += w; else if (j === NZ) z -= w;
    }
    const cn = Math.exp(-Math.pow(z / 0.32, 2));
    const rel = AMP * (0.55 * Math.sin(x * 11.3 + z * 4.1) + 0.45 * Math.sin(x * 5.7 - z * 13.9 + 2.1));
    const y = TH + rel * (1 - 0.7 * cn) - lived * 0.006 * cn;
    top[i].push(new THREE.Vector3(x, y, z));
    bot[i].push(new THREE.Vector3(x, 0, z));
  }
}

const foldV = (m) => [NX - KRUCK + m, NZ - m];
{
  const [a0, b0] = foldV(0), [a1, b1] = foldV(KRUCK);
  const y0 = top[a0][b0].y, y1 = top[a1][b1].y;
  for (let m = 1; m < KRUCK; m++) {
    const [a, b] = foldV(m);
    top[a][b].y = y0 + (y1 - y0) * (m / KRUCK);
  }
}

if (lived > 0) {
  const PHI = lived * (95 * Math.PI / 180);
  const [a0, b0] = foldV(0), [a1, b1] = foldV(KRUCK);
  const axis = new THREE.Vector3().subVectors(top[a1][b1], top[a0][b0]).setY(0).normalize();
  for (let m = 1; m <= KRUCK; m++) {
    const phi = -PHI * Math.pow(m / KRUCK, 1.5);
    const hs = KRUCK - m + 1;
    const pivot = top[NX - hs][NZ].clone();
    for (let i = 0; i <= NX; i++) for (let j = 0; j <= NZ; j++) {
      if ((NX - i) + (NZ - j) > KRUCK - m) continue;
      for (const v of [top[i][j], bot[i][j]]) {
        v.sub(pivot).applyAxisAngle(axis, phi).add(pivot);
      }
    }
  }
}

const toA = (v) => [v.x, v.y, v.z];
return { top: top.map((row) => row.map(toA)), bot: bot.map((row) => row.map(toA)), NX, NZ };
>>>
n n1 get object=@n0 key=NX
n n2 get object=@n0 key=NZ
n n3 solidify grid=@n0 NX=@n1 NZ=@n2 pattern=$pattern topZoneField=`i===0 || i===s.NX-1 || k===0 || k===s.NZ-1 ? (s.pattern==='plain' ? 'field' : 'border') : (s.pattern==='geometric' && Math.floor(Math.abs(i+0.5-s.NX/2)+Math.abs(k+0.5-s.NZ/2)) % 3 === 1 ? 'motif' : 'field')` botZone=backing wallZone=backing diagonal=ref wallOrder=ref
n n4 mesh geom=@n3 zones={field:~`s => s.field || ({"linen-sage":{"field":"#F3EEE8","border":"#7E9179","motif":"#B8946A","backing":"#A89A85"},"oat-terracotta":{"field":"#F8F4EF","border":"#C4623F","motif":"#CFC3B0","backing":"#B4AAA0"},"walnut-ochre":{"field":"#E3CBA5","border":"#6B4A32","motif":"#D9A02B","backing":"#8A6244"},"slate-teal":{"field":"#F0F2F1","border":"#3E7C86","motif":"#B4AAA0","backing":"#8C837A"}})[s.colorway].field`,border:~`s => s.border || ({"linen-sage":{"field":"#F3EEE8","border":"#7E9179","motif":"#B8946A","backing":"#A89A85"},"oat-terracotta":{"field":"#F8F4EF","border":"#C4623F","motif":"#CFC3B0","backing":"#B4AAA0"},"walnut-ochre":{"field":"#E3CBA5","border":"#6B4A32","motif":"#D9A02B","backing":"#8A6244"},"slate-teal":{"field":"#F0F2F1","border":"#3E7C86","motif":"#B4AAA0","backing":"#8C837A"}})[s.colorway].border`,motif:~`s => s.motif || ({"linen-sage":{"field":"#F3EEE8","border":"#7E9179","motif":"#B8946A","backing":"#A89A85"},"oat-terracotta":{"field":"#F8F4EF","border":"#C4623F","motif":"#CFC3B0","backing":"#B4AAA0"},"walnut-ochre":{"field":"#E3CBA5","border":"#6B4A32","motif":"#D9A02B","backing":"#8A6244"},"slate-teal":{"field":"#F0F2F1","border":"#3E7C86","motif":"#B4AAA0","backing":"#8C837A"}})[s.colorway].motif`,backing:~`s => s.backing || ({"linen-sage":{"field":"#F3EEE8","border":"#7E9179","motif":"#B8946A","backing":"#A89A85"},"oat-terracotta":{"field":"#F8F4EF","border":"#C4623F","motif":"#CFC3B0","backing":"#B4AAA0"},"walnut-ochre":{"field":"#E3CBA5","border":"#6B4A32","motif":"#D9A02B","backing":"#8A6244"},"slate-teal":{"field":"#F0F2F1","border":"#3E7C86","motif":"#B4AAA0","backing":"#8C837A"}})[s.colorway].backing`}
out mesh=@n4
end
