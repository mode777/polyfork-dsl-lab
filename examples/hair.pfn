# polyfork graph v2 — hair
graph hair
in curlCount int 150 min=20 max=400
in curlSize float 0.022 min=0.01 max=0.04
n n0 sphere r=0.11 seg=14 rings=10 y=0.06 zone=skin
n n1 cylinder r1=0.05 r2=0.045 h=0.12 seg=8 y=-0.06 zone=skin
n n2 ring n=14 r=0.09 y=0 sz=0.7
n n3 ring n=14 r=0.16 y=-0.03 sz=0.6
n n4 ring n=14 r=0.19 y=-0.06 sz=0.55
n n5 loft rings=[@n2,@n3,@n4] zones={band:shirt}
n n6 scatterVolume count=$curlCount minDist=~`s => s.curlSize * 0.9` seed=7 center=[0,0.06,0] radius=[0.105,0.125,0.105] keep=`(n[2] < 0.55 || y > 0.12) && (y > 0.02)` size=`s.curlSize`
n n7 curl size=1 tip=0.32 sink=0.05 zone=hair
n n8 instance points=@n6 proto=@n7
n n9 join geoms=[@n5,@n1,@n0,@n8]
n n10 mesh geom=@n9 zones={skin:#c29a78,hair:#4a2f22,shirt:#3f4a5a}
out mesh=@n10
end
