# polyfork graph v2 — hair
graph hair
in curlCount int 90 min=20 max=300
in curlSize float 0.018 min=0.008 max=0.032
n n0 sphere r=0.11 seg=14 rings=10 y=0.06 zone=skin
n n1 cylinder r1=0.05 r2=0.045 h=0.12 seg=8 y=-0.06 zone=skin
n n2 ring n=14 r=0.09 y=0 sz=0.7
n n3 ring n=14 r=0.16 y=-0.03 sz=0.6
n n4 ring n=14 r=0.19 y=-0.06 sz=0.55
n n5 loft rings=[@n2,@n3,@n4] zones={band:shirt}
n n6 sphere r=0.114 seg=14 rings=10 y=0.078 zone=hair
n n7 clip geom=@n6 nx=0 ny=0.15 nz=1 d=0.036 cap=true zone=hair
n n8 cylinder r1=0.035 r2=0.032 h=0.035 seg=8 x=0 y=0.01 z=-0.12 rx=0.55 zone=ribbon
n n9 cylinder r1=0.034 r2=0.012 h=0.2 seg=7 x=0 y=-0.045 z=-0.165 rx=0.55 zone=hair
n n10 scatterVolume count=$curlCount minDist=~`s => s.curlSize * 0.95` seed=7 center=[0,0.06,0] radius=[0.108,0.126,0.108] keep=`(z < 0.015 || y > 0.12) && y > 0.015` size=`s.curlSize`
n n11 curl size=1 tip=0.34 sink=0.04 zone=hair
n n12 instance points=@n10 proto=@n11
n n13 join geoms=[@n5,@n1,@n0,@n7,@n8,@n9,@n12]
n n14 mesh geom=@n13 zones={skin:#c29a78,hair:#4a2f22,shirt:#3f4a5a,ribbon:#2a303a}
out mesh=@n14
end
