# polyfork graph v2 — clam
graph clam
in colorway enum maxima-blue options=maxima-blue|crocea-teal|squamosa-gold|derasa-violet label=Colorway
in ribs int 9 min=6 max=9 step=1 label=Ribs
in flute float 0.17 min=0.08 max=0.28 step=0.01 label="Flute depth"
in dome float 1 min=0.65 max=1.15 step=0.01 label=Dome
n n0 preset choice=$colorway presets={maxima-blue:{shell:#E8C88A,margin:#B8894A,nacre:#F6F2E8,mantle:#3B5FC4,mantleDeep:#2A3E8F,stripe:#F6C13A,spot:#2B2E33},crocea-teal:{shell:#D4AC6A,margin:#8C6236,nacre:#F7F2E6,mantle:#4E9AAE,mantleDeep:#1B4E6B,stripe:#7FD4A8,spot:#2B2E33},squamosa-gold:{shell:#C9B79B,margin:#7E7059,nacre:#E6DCC6,mantle:#F6C13A,mantleDeep:#E85F1E,stripe:#FFF9EA,spot:#2B2E33},derasa-violet:{shell:#E8C88A,margin:#B8894A,nacre:#F6F2E8,mantle:#6E4FA8,mantleDeep:#2A3E8F,stripe:#B0568C,spot:#2B2E33}} fallback=maxima-blue
n n1 clamAnimal ribs=$ribs flute=$flute dome=$dome
n n2 mesh geom=@n1 zones={shell:@n0.shell,margin:@n0.margin,nacre:@n0.nacre,mantle:@n0.mantle,mantleDeep:@n0.mantleDeep,stripe:@n0.stripe,spot:@n0.spot}
out mesh=@n2
end
