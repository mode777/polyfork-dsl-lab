# polyfork graph v2 — tire
graph tire
group tire-profile
in item any null
n n0 value expr="[item[0], (item[1] - 0.0035) * s.width]"
out out=@n0
end
group tire-zone
in item any null
n n0 value expr="item[4] || 'rim'"
out out=@n0
end
in colorway enum whitewall-chrome options=whitewall-chrome|blackwall-steel|redline|worn-spare label=Colorway
in rubber color "" label=Rubber
in sidewall color "" label=Sidewall
in rim color "" label="Rim face"
in chrome color "" label="Hubcap chrome"
in facets int 14 min=12 max=16 step=1 label=Facets
in width float 1 min=0.7 max=1.35 step=0.05 label="Section width"
in rimSize float 1 min=0.85 max=1.2 step=0.05 label="Rim size"
n n0 value expr="[[0.21*s.rimSize*0.72, -0.105, 0, 0, 'rim'], [0.21*s.rimSize*0.72, -0.135, 0, 0, 'rub'], [0.30, -0.135, 0, 0, 'rub'], [0.35, -0.112, 0.013, 0, 'rub'], [0.35, -0.062, 0.013, 0, 'rub'], [0.32, -0.040, 0, 0, 'rub'], [0.35, -0.018, 0.013, 1, 'rub'], [0.35, 0.018, 0.013, 1, 'rub'], [0.32, 0.040, 0, 0, 'rub'], [0.35, 0.062, 0.013, 0, 'rub'], [0.35, 0.112, 0.013, 0, 'rub'], [0.30, 0.135, 0, 0, 'ww'], [0.21*s.rimSize + 0.014, 0.135, 0, 0, 'rub'], [0.21*s.rimSize, 0.042, 0, 0, 'rim'], [0.135*s.rimSize, 0.042, 0, 0, null]]"
n n1 map list=@n0 graph=tire-profile
n n2 map list=@n0 graph=tire-zone
n n3 value args={z:@n2} expr="z.slice(0, -1)"
n n4 value expr="0.21*s.rimSize*0.72"
n n5 value expr="(-0.105 - 0.0035)*s.width"
n n6 value expr="0.135*s.rimSize"
n n7 value expr="(0.042 - 0.0035)*s.width"
n n8 value expr="[[0.135*s.rimSize, (0.042-0.0035)*s.width], [0.118*s.rimSize, (0.098-0.0035)*s.width], [0.066*s.rimSize, (0.128-0.0035)*s.width]]"
n n9 value expr="0.066*s.rimSize"
n n10 value expr="(0.128 - 0.0035)*s.width"
n n11 value expr="(0.142 - 0.0035)*s.width"
n n12 value expr="0.023*s.rimSize"
n n13 value expr="0.018*s.width + 0.002"
n n14 value expr="0.105*s.rimSize"
n n15 value expr="(0.042 - 0.0035)*s.width - 0.002"
n n16 value expr="0.35*cos(PI/s.facets)"
n n17 revolve profile=@n1 seg=$facets zone=@n3 values={rows:@n0} axis=z phase=~`-PI/2 + PI/s.facets` ringMode=xz mod=`vals.rows[k][2] ? (min(i, s.seg-1-i)%2===vals.rows[k][3] ? vals.rows[k][0]-vals.rows[k][2] : vals.rows[k][0]) : vals.rows[k][0]`
n n18 fanRing r=@n4 y=@n5 n=$facets apex=[0,0,@n5] phase=~`-PI/2 + PI/s.facets` axis=z zone=rim flip=true
n n19 fanRing r=@n6 y=@n7 n=$facets apex=[0,0,@n7] phase=~`-PI/2 + PI/s.facets` axis=z zone=rim
n n20 revolve profile=@n8 seg=$facets axis=z phase=~`-PI/2 + PI/s.facets` zone=chrome
n n21 fanRing r=@n9 y=@n10 n=$facets apex=[0,0,@n11] phase=~`-PI/2 + PI/s.facets` axis=z zone=chrome
n n22 cone r=@n12 h=@n13 x=@n14 z=@n15 n=6 y=0 axis=z zone=chrome
n n23 arrayPolar geom=@n22 count=5 axis=z start=1.5707963267948966 spin=false
n n24 join geoms=[@n17,@n18,@n19,@n20,@n21,@n23]
n n25 center geom=@n24 y=false
n n26 transform geom=@n25 ty=@n16
n n27 mesh geom=@n26 zones={rub:~`s.rubber || ({"whitewall-chrome":{"rubber":"#2a2d35","sidewall":"#f1f2ef","rim":"#999ca3","chrome":"#c2c7cd"},"blackwall-steel":{"rubber":"#2a2d35","sidewall":"#3d3f46","rim":"#676b72","chrome":"#afb5bb"},"redline":{"rubber":"#2a2d35","sidewall":"#d13d34","rim":"#c2c7cd","chrome":"#f1f2ef"},"worn-spare":{"rubber":"#3d3f46","sidewall":"#898c95","rim":"#676b72","chrome":"#999ca3"}}[s.colorway] || {"whitewall-chrome":{"rubber":"#2a2d35","sidewall":"#f1f2ef","rim":"#999ca3","chrome":"#c2c7cd"},"blackwall-steel":{"rubber":"#2a2d35","sidewall":"#3d3f46","rim":"#676b72","chrome":"#afb5bb"},"redline":{"rubber":"#2a2d35","sidewall":"#d13d34","rim":"#c2c7cd","chrome":"#f1f2ef"},"worn-spare":{"rubber":"#3d3f46","sidewall":"#898c95","rim":"#676b72","chrome":"#999ca3"}}['whitewall-chrome']).rubber`,ww:~`s.sidewall || ({"whitewall-chrome":{"rubber":"#2a2d35","sidewall":"#f1f2ef","rim":"#999ca3","chrome":"#c2c7cd"},"blackwall-steel":{"rubber":"#2a2d35","sidewall":"#3d3f46","rim":"#676b72","chrome":"#afb5bb"},"redline":{"rubber":"#2a2d35","sidewall":"#d13d34","rim":"#c2c7cd","chrome":"#f1f2ef"},"worn-spare":{"rubber":"#3d3f46","sidewall":"#898c95","rim":"#676b72","chrome":"#999ca3"}}[s.colorway] || {"whitewall-chrome":{"rubber":"#2a2d35","sidewall":"#f1f2ef","rim":"#999ca3","chrome":"#c2c7cd"},"blackwall-steel":{"rubber":"#2a2d35","sidewall":"#3d3f46","rim":"#676b72","chrome":"#afb5bb"},"redline":{"rubber":"#2a2d35","sidewall":"#d13d34","rim":"#c2c7cd","chrome":"#f1f2ef"},"worn-spare":{"rubber":"#3d3f46","sidewall":"#898c95","rim":"#676b72","chrome":"#999ca3"}}['whitewall-chrome']).sidewall`,rim:~`s.rim || ({"whitewall-chrome":{"rubber":"#2a2d35","sidewall":"#f1f2ef","rim":"#999ca3","chrome":"#c2c7cd"},"blackwall-steel":{"rubber":"#2a2d35","sidewall":"#3d3f46","rim":"#676b72","chrome":"#afb5bb"},"redline":{"rubber":"#2a2d35","sidewall":"#d13d34","rim":"#c2c7cd","chrome":"#f1f2ef"},"worn-spare":{"rubber":"#3d3f46","sidewall":"#898c95","rim":"#676b72","chrome":"#999ca3"}}[s.colorway] || {"whitewall-chrome":{"rubber":"#2a2d35","sidewall":"#f1f2ef","rim":"#999ca3","chrome":"#c2c7cd"},"blackwall-steel":{"rubber":"#2a2d35","sidewall":"#3d3f46","rim":"#676b72","chrome":"#afb5bb"},"redline":{"rubber":"#2a2d35","sidewall":"#d13d34","rim":"#c2c7cd","chrome":"#f1f2ef"},"worn-spare":{"rubber":"#3d3f46","sidewall":"#898c95","rim":"#676b72","chrome":"#999ca3"}}['whitewall-chrome']).rim`,chrome:~`s.chrome || ({"whitewall-chrome":{"rubber":"#2a2d35","sidewall":"#f1f2ef","rim":"#999ca3","chrome":"#c2c7cd"},"blackwall-steel":{"rubber":"#2a2d35","sidewall":"#3d3f46","rim":"#676b72","chrome":"#afb5bb"},"redline":{"rubber":"#2a2d35","sidewall":"#d13d34","rim":"#c2c7cd","chrome":"#f1f2ef"},"worn-spare":{"rubber":"#3d3f46","sidewall":"#898c95","rim":"#676b72","chrome":"#999ca3"}}[s.colorway] || {"whitewall-chrome":{"rubber":"#2a2d35","sidewall":"#f1f2ef","rim":"#999ca3","chrome":"#c2c7cd"},"blackwall-steel":{"rubber":"#2a2d35","sidewall":"#3d3f46","rim":"#676b72","chrome":"#afb5bb"},"redline":{"rubber":"#2a2d35","sidewall":"#d13d34","rim":"#c2c7cd","chrome":"#f1f2ef"},"worn-spare":{"rubber":"#3d3f46","sidewall":"#898c95","rim":"#676b72","chrome":"#999ca3"}}['whitewall-chrome']).chrome`}
out mesh=@n27
end
