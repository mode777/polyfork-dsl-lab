n n26 value args={a:4.71238898038469,r:0.034} expr="sin(a)*r"
n n27 value args={x:@n0,a:5.759586531581288,r:0.034} expr="x + cos(a)*r"
n n28 value args={a:5.759586531581288,r:0.034} expr="sin(a)*r"
n n29 value args={y1:$y1,PT:0.012} expr="y1 + PT"
