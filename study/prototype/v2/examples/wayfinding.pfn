n n31 prism profile=[[@n17,@n18],[@n19,@n20],[@n21,@n22],[@n23,@n24],[@n25,@n26],[@n27,@n28]] from=@n29 to=@n30 axis=y cap=top capOrient=true zone=steel
n n32 value args={y1:$y1,PT:0.012,chan:$CHAN} expr="4 - chan - (y1 + PT)"
n n33 value args={y1:$y1,PT:0.012} expr="y1 + PT"
n n34 cylinder h=@n32 x=@n0 y=@n33 r1=0.022 r2=0.022 seg=8 z=0 caps=false zone=steel
n n35 value args={x:@n0,a:0.5235987755982988,r:0.034} expr="x + cos(a)*r"
n n36 value args={a:0.5235987755982988,r:0.034} expr="sin(a)*r"
