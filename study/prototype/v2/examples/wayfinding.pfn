n n17 value args={x:@n0,a:0.5235987755982988,r:0.034} expr="x + cos(a)*r"
n n18 value args={a:0.5235987755982988,r:0.034} expr="sin(a)*r"
n n19 value args={x:@n0,a:1.5707963267948966,r:0.034} expr="x + cos(a)*r"
n n20 value args={a:1.5707963267948966,r:0.034} expr="sin(a)*r"
