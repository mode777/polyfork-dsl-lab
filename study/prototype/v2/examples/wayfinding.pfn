out out=@n50
end
in colorway enum terminal-slate options=terminal-slate|warm-charcoal|navy|pale-steel label=Colorway
in housing color "" label=Housing
in field color "" label="Sign field"
in light color "" label="Light ring"
in steel color "" label=Steel
in width float 2.4 min=2 max=6 step=0.1 label=Width
in drop float 0.8 min=0.4 max=1.2 step=0.05 label=Drop
in endLights bool true label="Lit ends"
in arrow enum right options=none|right|left|up label=Arrow
in letters enum A options=none|A|B|C|D|E label=Letter
in icons enum departures-toilets options=none|departures|arrivals|toilets|baggage|bag-pickup|departures-toilets|arrivals-bag-pickup label=Icons
in legend color "" label=Legend
in wear float 0.2 min=0 max=1 step=0.1 label=Wear
n n0 let width=$width drop=$drop binds={W:width,H:0.6,D:0.32,CH:0.03,CHAN:0.041,PITCH:2.4,ROD_R:0.022,y1:"4 - drop",y0:"4 - drop - 0.6",cy:"4 - drop - 0.3",halfW:width/2,halfD:0.16,xo:"width/2 - 0.45",count:"max(2, ceil(2*(width/2 - 0.45)/2.4 - 1e-6) + 1)",yt:"4 - drop + 0.3*drop",k:"min(0.22, 0.4*drop)",fieldW:"width - 0.26",legendW:"width - 0.42"}
