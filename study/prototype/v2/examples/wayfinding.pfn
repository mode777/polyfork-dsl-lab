# polyfork graph v2 — wayfinding
graph wayfinding
group hanger
in item any 0
in xo any 0
in count any 2
in y1 any 3.2
in CHAN any 0.041
n n0 value args={i:$item,xo:$xo,count:$count} expr="count <= 1 ? 0 : -xo + 2*xo*i/(count-1)"
n n1 value args={x:@n0,PL:0.07} expr="x - PL"
n n2 value args={x:@n0,PL:0.07} expr="x + PL"
n n3 value args={y1:$y1,PT:0.012} expr="y1 + PT"
n n4 block x0=@n1 x1=@n2 y0=$y1 y1=@n3 z0=-0.07 z1=0.07 skip=ny zone=steel
n n5 value args={x:@n0,sx:-1,PL:0.07} expr="x + sx*(PL - 0.022)"
n n6 value args={y1:$y1,PT:0.012} expr="y1 + PT"
n n7 cone x=@n5 y=@n6 n=6 r=0.011 h=0.007 z=-0.04800000000000001 flip=true zone=steel
n n8 value args={x:@n0,sx:-1,PL:0.07} expr="x + sx*(PL - 0.022)"
n n9 value args={y1:$y1,PT:0.012} expr="y1 + PT"
