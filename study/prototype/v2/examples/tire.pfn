# polyfork graph v2 — tire
graph tire
layout tire-data
in facets int 14
in width float 1
in rimSize float 1

const R_OUT = 0.35, R_SHLD = 0.30, HW = 0.135, GROOVE = 0.030, BLOCK = 0.013;
const BORE0 = 0.21, HUB0 = 0.135, DISH_Z = 0.042, BACK_R = 0.72, BACK_Z = -0.105, APEX_Z = 0.142;
const N = Math.round(facets), W = width, RS = rimSize;
const BORE = BORE0 * RS, HUBR = HUB0 * RS, WWI = BORE + 0.014, BKR = BORE * BACK_R, LUG_R = 0.105 * RS;
const CY = R_OUT * Math.cos(Math.PI / N), ZOFF = -((APEX_Z - HW) / 2) * W;
const PROF = [
  [BKR, BACK_Z, 0, 0, 'rim'], [BKR, -0.135, 0, 0, 'rub'], [R_SHLD, -0.135, 0, 0, 'rub'],
  [R_OUT, -0.112, BLOCK, 0, 'rub'], [R_OUT, -0.062, BLOCK, 0, 'rub'], [R_OUT - GROOVE, -0.040, 0, 0, 'rub'],
  [R_OUT, -0.018, BLOCK, 1, 'rub'], [R_OUT, 0.018, BLOCK, 1, 'rub'], [R_OUT - GROOVE, 0.040, 0, 0, 'rub'],
  [R_OUT, 0.062, BLOCK, 0, 'rub'], [R_OUT, 0.112, BLOCK, 0, 'rub'], [R_SHLD, 0.135, 0, 0, 'ww'],
  [WWI, 0.135, 0, 0, 'rub'], [BORE, DISH_Z, 0, 0, 'rim'], [HUBR, DISH_Z, 0, 0, null],
];
const CAP = [[HUBR, DISH_Z], [0.118 * RS, 0.098], [0.066 * RS, 0.128]];
const radius = ({ i, k }) => { const row = PROF[k]; return row[2] ? (Math.min(i, N - 1 - i) % 2 === row[3] ? row[0] - row[2] : row[0]) : row[0]; };

out N=N
out CY=CY
out profile=PROF.map((r) => [r[0], r[1] * W + ZOFF])
out zones=PROF.slice(0, -1).map((r) => r[4] ?? 'rim')
out radius=radius
out BKR=BKR
out backY=BACK_Z * W + ZOFF
out HUBR=HUBR
out dishY=DISH_Z * W + ZOFF
out domeProfile=CAP.map(([r, z]) => [r, z * W + ZOFF])
out domeR=0.066 * RS
out domeY=0.128 * W + ZOFF
out apexY=APEX_Z * W + ZOFF
out lugR=0.023 * RS
out lugH=0.018 * W + 0.002
out lugX=LUG_R
out lugZ=DISH_Z * W + ZOFF - 0.002
end
in colorway enum whitewall-chrome options=whitewall-chrome|blackwall-steel|redline|worn-spare label=Colorway
in rubber color "" label=Rubber
in sidewall color "" label=Sidewall
in rim color "" label="Rim face"
in chrome color "" label="Hubcap chrome"
in facets int 14 min=12 max=16 step=1 label=Facets
in width float 1 min=0.7 max=1.35 step=0.05 label="Section width"
in rimSize float 1 min=0.85 max=1.2 step=0.05 label="Rim size"
n n0 layout facets=$facets width=$width rimSize=$rimSize graph=tire-data
n n1 revolve profile=@n0.profile seg=$facets zone=@n0.zones mod=@n0.radius axis=z phase=~`s => -Math.PI/2 + Math.PI/s.facets` ringMode=xz
n n2 fanRing r=@n0.BKR y=@n0.backY n=$facets apex=[0,0,@n0.backY] phase=~`s => -Math.PI/2 + Math.PI/s.facets` axis=z zone=rim flip=true
n n3 fanRing r=@n0.HUBR y=@n0.dishY n=$facets apex=[0,0,@n0.dishY] phase=~`s => -Math.PI/2 + Math.PI/s.facets` axis=z zone=rim
n n4 revolve profile=@n0.domeProfile seg=$facets axis=z phase=~`s => -Math.PI/2 + Math.PI/s.facets` zone=chrome
n n5 fanRing r=@n0.domeR y=@n0.domeY n=$facets apex=[0,0,@n0.apexY] phase=~`s => -Math.PI/2 + Math.PI/s.facets` axis=z zone=chrome
n n6 cone r=@n0.lugR h=@n0.lugH x=@n0.lugX z=@n0.lugZ n=6 y=0 axis=z zone=chrome
n n7 arrayPolar geom=@n6 count=5 axis=z start=1.5707963267948966 spin=false
n n8 join geoms=[@n1,@n2,@n3,@n4,@n5,@n7]
n n9 center geom=@n8 y=false
n n10 transform geom=@n9 ty=@n0.CY
n n11 mesh geom=@n10 zones={rub:~`s => s.rubber || ({"whitewall-chrome":{"rubber":"#2a2d35","sidewall":"#f1f2ef","rim":"#999ca3","chrome":"#c2c7cd"},"blackwall-steel":{"rubber":"#2a2d35","sidewall":"#3d3f46","rim":"#676b72","chrome":"#afb5bb"},"redline":{"rubber":"#2a2d35","sidewall":"#d13d34","rim":"#c2c7cd","chrome":"#f1f2ef"},"worn-spare":{"rubber":"#3d3f46","sidewall":"#898c95","rim":"#676b72","chrome":"#999ca3"}})[s.colorway].rubber`,ww:~`s => s.sidewall || ({"whitewall-chrome":{"rubber":"#2a2d35","sidewall":"#f1f2ef","rim":"#999ca3","chrome":"#c2c7cd"},"blackwall-steel":{"rubber":"#2a2d35","sidewall":"#3d3f46","rim":"#676b72","chrome":"#afb5bb"},"redline":{"rubber":"#2a2d35","sidewall":"#d13d34","rim":"#c2c7cd","chrome":"#f1f2ef"},"worn-spare":{"rubber":"#3d3f46","sidewall":"#898c95","rim":"#676b72","chrome":"#999ca3"}})[s.colorway].sidewall`,rim:~`s => s.rim || ({"whitewall-chrome":{"rubber":"#2a2d35","sidewall":"#f1f2ef","rim":"#999ca3","chrome":"#c2c7cd"},"blackwall-steel":{"rubber":"#2a2d35","sidewall":"#3d3f46","rim":"#676b72","chrome":"#afb5bb"},"redline":{"rubber":"#2a2d35","sidewall":"#d13d34","rim":"#c2c7cd","chrome":"#f1f2ef"},"worn-spare":{"rubber":"#3d3f46","sidewall":"#898c95","rim":"#676b72","chrome":"#999ca3"}})[s.colorway].rim`,chrome:~`s => s.chrome || ({"whitewall-chrome":{"rubber":"#2a2d35","sidewall":"#f1f2ef","rim":"#999ca3","chrome":"#c2c7cd"},"blackwall-steel":{"rubber":"#2a2d35","sidewall":"#3d3f46","rim":"#676b72","chrome":"#afb5bb"},"redline":{"rubber":"#2a2d35","sidewall":"#d13d34","rim":"#c2c7cd","chrome":"#f1f2ef"},"worn-spare":{"rubber":"#3d3f46","sidewall":"#898c95","rim":"#676b72","chrome":"#999ca3"}})[s.colorway].chrome`}
out mesh=@n11
end
