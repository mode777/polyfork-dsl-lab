# polyfork graph v2 — sapphire
graph sapphire
group gem-station
in item any null
in rng any null
in n any null
in pl any null
in irr any null
in bar any null
n n0 draws rng=$rng item=$item n=2 offset=12
n n1 let item=$item n=$n pl=$pl irr=$irr bar=$bar d=@n0 binds={x:"(n === 3 && item === 1) ? 0 : (item === 0 ? -pl/2 : pl/2)",base:"(n === 3 && item === 1) ? 1 + 0.18 * bar : 1",s:"base * (1 + (d[0]*2 - 1) * 0.1 * irr)",dz:"(d[1]*2 - 1) * 0.1 * 0.034 * irr"}
out out=@n1
end
group gem-ring-point
in item any null
in st any null
n n0 value expr="[st.x, item[1] * st.s, item[0] * st.s + st.dz]"
out out=@n0
end
group gem-ring
in item any null
in profile any null
n n0 map list=$profile st=$item graph=gem-ring-point
out out=@n0
end
group gem-cap-ring
in item any null
in apex any null
n n0 lerpPoint a=$item b=$apex t=0.55
out out=@n0
end
group gem-mirror-point
in item any null
n n0 mirrorPoint point=$item axis=x
out out=@n0
end
group gem-mirror-ring
in item any null
n n0 map list=$item graph=gem-mirror-point
out out=@n0
end
in colorway enum royal-blue options=royal-blue|ruby-red|golden-yellow|green|white label=Colorway
in gem color "" label=Gem
in length float 1 min=0.5 max=1.8 step=0.05 label="Prism length"
in barrel float 0 min=0 max=1 step=0.05 label="Barrel bulge"
in ends enum pointed options=pointed|truncated|broken label=Terminations
in chamfer float 0.3 min=0 max=1 step=0.05 label="Edge bevel"
in irregularity float 0 min=0 max=1 step=0.05 label="Natural irregularity"
n n0 let length=$length barrel=$barrel irregularity=$irregularity chamfer=$chamfer binds={pl:"0.074 * clamp(length, 0.5, 1.8)",irr:"clamp(irregularity, 0, 1)",bar:"clamp(barrel, 0, 1)",ch:"clamp(chamfer, 0, 1)",n:"(bar > 0.001 || irr > 0.001) ? 3 : 2",draws:"12 + 2 * n"}
n n1 random count=@n0.draws seed=20261103
n n2 value expr="[[0.034, 0.023], [0.017, 0.046], [-0.017, 0.046], [-0.034, 0.023], [-0.017, 0], [0.017, 0]]"
n n3 value expr="[[0.00408, 0.00414], [0.00612, 0.00276], [0.00612, 0.00276], [0.00408, 0.00414], [0.00544, 0], [0.00544, 0]]"
n n4 jitter points=@n2 amps=@n3 rng=@n1 amount=@n0.irr offset=0 dims=2
n n5 bevelProfile profile=@n4 dist=~`clamp(s.chamfer,0,1) * 0.2 * 0.034`
n n6 if cond=~`clamp(s.chamfer,0,1) > 0.001` then=@n5 else=@n4
n n7 range to=@n0.n from=0
n n8 map list=@n7 rng=@n1 n=@n0.n pl=@n0.pl irr=@n0.irr bar=@n0.bar graph=gem-station
n n9 map list=@n8 profile=@n6 graph=gem-ring
n n10 first list=@n9
n n11 last list=@n9
n n12 random seed=@n1.state count=6
n n13 value args={ring:@n11,t:@n12.values} expr=<<<
let c = centroid(ring), irr = clamp(s.irregularity, 0, 1) in
      [c[0] + 0.033 * (1 + 0.3 * (t[0]*2 - 1) * irr),
       c[1] + (t[1]*2 - 1) * 0.25 * 0.023 * irr,
       c[2] + (t[2]*2 - 1) * 0.25 * 0.034 * irr]
>>>
n n14 value args={ring:@n10,t:@n12.values} expr=<<<
let c = centroid(ring), irr = clamp(s.irregularity, 0, 1) in
      [c[0] - 0.033 * (1 + 0.3 * (t[3]*2 - 1) * irr),
       c[1] + (t[4]*2 - 1) * 0.25 * 0.023 * irr,
       c[2] + (t[5]*2 - 1) * 0.25 * 0.034 * irr]
>>>
n n15 loftProfile profile=@n6 capTop=@n13 capBottom=@n14 stations=@n8 zones={band:gem,capTop:gem,capBottom:gem} orient=true
n n16 map list=@n11 apex=@n13 graph=gem-cap-ring
n n17 map list=@n10 apex=@n14 graph=gem-cap-ring
n n18 centroid points=@n16
n n19 centroid points=@n17
n n20 loft rings=@n9 zones={band:gem} orient=true
n n21 loft rings=[@n11,@n16] zones={band:gem} orient=true
n n22 loft rings=[@n16] capTop=@n18 zones={capTop:gem} orient=true
n n23 loft rings=[@n10,@n17] zones={band:gem} orient=true
n n24 loft rings=[@n17] capBottom=@n19 zones={capBottom:gem} orient=true
n n25 join geoms=[@n20,@n21,@n22,@n23,@n24]
n n26 value args={rings:@n9} expr="rings[1]"
n n27 value args={ring:@n10} expr="centroid(ring)[1]"
n n28 value args={r0:@n10,r1:@n26} expr="r0[0][0] + 0.3*(r1[0][0] - r0[0][0])"
n n29 planeCut r0=@n10 r1=@n26 xc=@n28 yc=@n27 a=0.45 b=0.3
n n30 map list=@n29 graph=gem-mirror-point
n n31 map list=@n9 graph=gem-mirror-ring
n n32 slice list=@n31 from=1
n n33 concat lists=[[@n30],@n32]
n n34 last list=@n33
n n35 mirrorPoint point=@n13 axis=x
n n36 value args={ring:@n30} expr="let c = centroid(ring) in [c[0] - 0.3*0.033, c[1] + 0.2*0.023, c[2] - 0.2*0.034]"
n n37 loft rings=@n33 zones={band:gem} orient=true
n n38 loft rings=[@n34] capTop=@n35 zones={capTop:gem} orient=true
n n39 loft rings=[@n30] capBottom=@n36 zones={capBottom:gem} orient=true
n n40 reverse geom=@n39
n n41 join geoms=[@n37,@n38,@n40]
n n42 switch cases={pointed:@n15,truncated:@n25,broken:@n41} on=$ends
n n43 preset choice=$colorway presets={royal-blue:#536aaa,ruby-red:#a2222d,golden-yellow:#dbbf57,green:#50a14f,white:#dddbdb} fallback=royal-blue
n n44 center geom=@n42
n n45 coalesce value=$gem fallback=@n43
n n46 mesh geom=@n44 zones={gem:@n45} materials={gem:{roughness:0.22,metalness:0.2}}
out mesh=@n46
end
