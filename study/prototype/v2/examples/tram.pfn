# polyfork graph v2 — tram
graph tram
in colorway enum city-asphalt options=city-asphalt|fresh-blacktop|sun-faded|wet-slate label=Colorway
in gauge enum tram-1370 options=cape-1067|tram-1370|standard-1435 label="Track gauge"
n n0 preset choice=$colorway presets={city-asphalt:{asphalt:#3C4145,rail:#D8DADD,stone:#6B7278,base:#4E5459,paint:#F0EFEC},fresh-blacktop:{asphalt:#2E3134,rail:#E4E6E6,stone:#6B7278,base:#1B1D20,paint:#F7F5EF},sun-faded:{asphalt:#6B7278,rail:#F0EFEC,stone:#D8DADD,base:#8A9197,paint:#F7F5EF},wet-slate:{asphalt:#2E3134,rail:#8A9197,stone:#4E5459,base:#1B1D20,paint:#E4E6E6}} fallback=city-asphalt
n n1 tramTile gauge=$gauge
n n2 mesh geom=@n1 zones={asphalt:@n0.asphalt,rail:@n0.rail,stone:@n0.stone,base:@n0.base,paint:@n0.paint}
out mesh=@n2
end
