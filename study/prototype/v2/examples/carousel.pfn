# polyfork graph v2 — carousel
graph carousel
in colorway enum terminal-grey options=terminal-grey|graphite|warm-steel label=Colorway
in load enum few options=empty|few|full label=Load
n n0 preset choice=$colorway presets={terminal-grey:{plates:#dddbdc,frame:#8fa5b1,skirt:#696568,hardCase:#3e6495,duffel:#b94c34},graphite:{plates:#e5e3e3,frame:#586f84,skirt:#282f3f,hardCase:#9b855d,duffel:#47592d},warm-steel:{plates:#eeeded,frame:#7b787c,skirt:#4c3a43,hardCase:#497aa2,duffel:#836047}} fallback=terminal-grey
n n1 carousel load=$load
n n2 mesh geom=@n1 zones={plates:@n0.plates,frame:@n0.frame,skirt:@n0.skirt,hardCase:@n0.hardCase,duffel:@n0.duffel}
out mesh=@n2
end
