# polyfork graph v2 — armchair
graph armchair
in colorway enum linen-mustard options=linen-mustard|oak-sage|walnut-teal|ochre-plum label=Colorway
in shellOuter color "" label="Shell outer"
in shellInner color "" label="Shell lining"
in cushion color "" label=Cushion
in leg color "" label=Legs
in backLine enum tub options=tub|wing label="Back line"
in lived_in float 0.35 min=0 max=1 step=0.05 label="Lived in"
in armLine float 0.5 min=0 max=1 step=0.05 label="Arm line"
n n0 preset choice=$colorway overrides={shellOuter:$shellOuter,shellInner:$shellInner,cushion:$cushion,leg:$leg} presets={linen-mustard:{shellOuter:#ECE7E0,shellInner:#F8F4EF,cushion:#D9A02B,leg:#6B4A32},oak-sage:{shellOuter:#CFC3B0,shellInner:#F3EEE8,cushion:#7E9179,leg:#B8946A},walnut-teal:{shellOuter:#B4AAA0,shellInner:#E3E6E4,cushion:#3E7C86,leg:#4E3423},ochre-plum:{shellOuter:#F3EEE8,shellInner:#FAF8F3,cushion:#7A4A5E,leg:#8A6244}} fallback=linen-mustard
n n1 value args={b:$backLine} expr="b === 'wing'"
n n2 armchair wing=@n1 lived=$lived_in armLine=$armLine
n n3 mesh geom=@n2 zones={shellOuter:@n0.shellOuter,shellInner:@n0.shellInner,cushion:@n0.cushion,leg:@n0.leg}
out mesh=@n3
end
