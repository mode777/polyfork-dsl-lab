# polyfork graph v2 — rug
graph rug
group rug-fold
in item any null
in acc any null
in NX any null
in NZ any null
n n0 value expr="acc.top[NX - (4 - item)][NZ]"
n n1 value expr="vnorm([acc.top[NX][NZ - 3][0] - acc.top[NX - 3][NZ][0], 0, acc.top[NX][NZ - 3][2] - acc.top[NX - 3][NZ][2]])"
n n2 value expr="-s.lived_in * (95 * PI / 180) * pow(item / 3, 1.5)"
n n3 deform geom=$acc values={pivot:@n0,axis:@n1,phi:@n2,NX:$NX,NZ:$NZ,item:$item} expr=`((vals.NX - i) + (vals.NZ - j) <= 3 - vals.item) ? vrot([x, y, z], vals.pivot, vals.axis, vals.phi) : [x, y, z]`
out out=@n3
end
in colorway enum linen-sage options=linen-sage|oat-terracotta|walnut-ochre|slate-teal label=Colorway
in field color "" label=Field
in border color "" label=Border
in motif color "" label=Motif
in backing color "" label=Backing
in pattern enum geometric options=plain|bordered|geometric label=Pattern
in size enum small options=small|large label=Size
in pile float 0.25 min=0 max=1 step=0.05 label=Pile
in lived_in float 0.35 min=0 max=1 step=0.05 label="Lived in"
n n0 value expr="s.size === 'large' ? 15 : 10"
n n1 value expr="s.size === 'large' ? 10 : 8"
n n2 value expr="s.size === 'large' ? 3 : 2"
n n3 value expr="s.size === 'large' ? 2 : 1.5"
n n4 value args={NX:@n0,NZ:@n1} expr="(NX + 1) * (NZ + 1)"
n n5 random count=@n4 seed=7681
n n6 grid nx=@n0 nz=@n1 w=@n2 d=@n3 values={NX:@n0,NZ:@n1,W:@n2,D:@n3,wob:@n5.values} position=`let px = vals.W / vals.NX, pz = vals.D / vals.NZ,\n      x0 = -vals.W/2 + i*px, z0 = -vals.D/2 + j*pz,\n      ax = clamp((abs(x0) - (vals.W/2 - 0.30)) / 0.30, 0, 1),\n      az = clamp((abs(z0) - (vals.D/2 - 0.30)) / 0.30, 0, 1),\n      cut = 0.07 * max(0, ax + az - 1),\n      x1 = x0 - sign(x0) * cut, z1 = z0 - sign(z0) * cut,\n      s0 = (vals.NX - i) + (vals.NZ - j),\n      w = vals.wob[i * (vals.NZ + 1) + j] * 0.024,\n      x2 = s0 !== 3 ? (i === 0 ? x1 + w : (i === vals.NX ? x1 - w : x1)) : x1,\n      z2 = s0 !== 3 ? (j === 0 ? z1 + w : (j === vals.NZ ? z1 - w : z1)) : z1,\n      cn = exp(-pow(z2 / 0.32, 2)),\n      amp = s.pile * 0.011, th = 0.014 + s.pile * 0.024,\n      rel = amp * (0.55 * sin(x2*11.3 + z2*4.1) + 0.45 * sin(x2*5.7 - z2*13.9 + 2.1)),\n      y = th + rel * (1 - 0.7*cn) - s.lived_in * 0.006 * cn\n    in [x2, y, z2]`
n n7 deform geom=@n6 values={grid:@n6,NX:@n0,NZ:@n1} expr=`let y0 = vals.grid.top[vals.NX - 3][vals.NZ][1],\n      y1 = vals.grid.top[vals.NX][vals.NZ - 3][1],\n      m = i - (vals.NX - 3)\n    in (side === 'top' && j === vals.NZ - m && m >= 1 && m < 3) ? [x, y0 + (y1 - y0) * (m / 3), z] : [x, y, z]`
n n8 range from=1 to=4
n n9 fold list=@n8 init=@n7 NX=@n0 NZ=@n1 graph=rug-fold
n n10 solidify grid=@n9 values={NX:@n0,NZ:@n1,pattern:$pattern} topZoneField=`(i === 0 || i === vals.NX - 1 || k === 0 || k === vals.NZ - 1)\n      ? (vals.pattern === 'plain' ? 'field' : 'border')\n      : (vals.pattern === 'geometric' && floor(abs(i + 0.5 - vals.NX/2) + abs(k + 0.5 - vals.NZ/2)) % 3 === 1 ? 'motif' : 'field')` botZone=backing wallZone=backing diagonal=ref wallOrder=ref
n n11 mesh geom=@n10 zones={field:~`s.field || ({"linen-sage":{"field":"#F3EEE8","border":"#7E9179","motif":"#B8946A","backing":"#A89A85"},"oat-terracotta":{"field":"#F8F4EF","border":"#C4623F","motif":"#CFC3B0","backing":"#B4AAA0"},"walnut-ochre":{"field":"#E3CBA5","border":"#6B4A32","motif":"#D9A02B","backing":"#8A6244"},"slate-teal":{"field":"#F0F2F1","border":"#3E7C86","motif":"#B4AAA0","backing":"#8C837A"}}[s.colorway] || {"linen-sage":{"field":"#F3EEE8","border":"#7E9179","motif":"#B8946A","backing":"#A89A85"},"oat-terracotta":{"field":"#F8F4EF","border":"#C4623F","motif":"#CFC3B0","backing":"#B4AAA0"},"walnut-ochre":{"field":"#E3CBA5","border":"#6B4A32","motif":"#D9A02B","backing":"#8A6244"},"slate-teal":{"field":"#F0F2F1","border":"#3E7C86","motif":"#B4AAA0","backing":"#8C837A"}}['linen-sage']).field`,border:~`s.border || ({"linen-sage":{"field":"#F3EEE8","border":"#7E9179","motif":"#B8946A","backing":"#A89A85"},"oat-terracotta":{"field":"#F8F4EF","border":"#C4623F","motif":"#CFC3B0","backing":"#B4AAA0"},"walnut-ochre":{"field":"#E3CBA5","border":"#6B4A32","motif":"#D9A02B","backing":"#8A6244"},"slate-teal":{"field":"#F0F2F1","border":"#3E7C86","motif":"#B4AAA0","backing":"#8C837A"}}[s.colorway] || {"linen-sage":{"field":"#F3EEE8","border":"#7E9179","motif":"#B8946A","backing":"#A89A85"},"oat-terracotta":{"field":"#F8F4EF","border":"#C4623F","motif":"#CFC3B0","backing":"#B4AAA0"},"walnut-ochre":{"field":"#E3CBA5","border":"#6B4A32","motif":"#D9A02B","backing":"#8A6244"},"slate-teal":{"field":"#F0F2F1","border":"#3E7C86","motif":"#B4AAA0","backing":"#8C837A"}}['linen-sage']).border`,motif:~`s.motif || ({"linen-sage":{"field":"#F3EEE8","border":"#7E9179","motif":"#B8946A","backing":"#A89A85"},"oat-terracotta":{"field":"#F8F4EF","border":"#C4623F","motif":"#CFC3B0","backing":"#B4AAA0"},"walnut-ochre":{"field":"#E3CBA5","border":"#6B4A32","motif":"#D9A02B","backing":"#8A6244"},"slate-teal":{"field":"#F0F2F1","border":"#3E7C86","motif":"#B4AAA0","backing":"#8C837A"}}[s.colorway] || {"linen-sage":{"field":"#F3EEE8","border":"#7E9179","motif":"#B8946A","backing":"#A89A85"},"oat-terracotta":{"field":"#F8F4EF","border":"#C4623F","motif":"#CFC3B0","backing":"#B4AAA0"},"walnut-ochre":{"field":"#E3CBA5","border":"#6B4A32","motif":"#D9A02B","backing":"#8A6244"},"slate-teal":{"field":"#F0F2F1","border":"#3E7C86","motif":"#B4AAA0","backing":"#8C837A"}}['linen-sage']).motif`,backing:~`s.backing || ({"linen-sage":{"field":"#F3EEE8","border":"#7E9179","motif":"#B8946A","backing":"#A89A85"},"oat-terracotta":{"field":"#F8F4EF","border":"#C4623F","motif":"#CFC3B0","backing":"#B4AAA0"},"walnut-ochre":{"field":"#E3CBA5","border":"#6B4A32","motif":"#D9A02B","backing":"#8A6244"},"slate-teal":{"field":"#F0F2F1","border":"#3E7C86","motif":"#B4AAA0","backing":"#8C837A"}}[s.colorway] || {"linen-sage":{"field":"#F3EEE8","border":"#7E9179","motif":"#B8946A","backing":"#A89A85"},"oat-terracotta":{"field":"#F8F4EF","border":"#C4623F","motif":"#CFC3B0","backing":"#B4AAA0"},"walnut-ochre":{"field":"#E3CBA5","border":"#6B4A32","motif":"#D9A02B","backing":"#8A6244"},"slate-teal":{"field":"#F0F2F1","border":"#3E7C86","motif":"#B4AAA0","backing":"#8C837A"}}['linen-sage']).backing`}
out mesh=@n11
end
